# Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values

# API Configuration
VITE_API_URL=http://localhost:8000/api
VITE_API_TIMEOUT=30000

# Application Configuration
VITE_APP_NAME=ManoMitra AI
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_CRISIS_PANEL=true
VITE_ENABLE_SCREENING=true
VITE_ENABLE_VIDEO_ANALYSIS=false
VITE_ENABLE_VOICE_ANALYSIS=true

# UI Configuration
VITE_THEME=light
VITE_DEFAULT_LANGUAGE=en

# Session Configuration
VITE_SESSION_TIMEOUT_MINUTES=30

# Analytics (optional)
# VITE_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
# VITE_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxxx

# Third-party Services (optional)
# VITE_CRISP_CHAT_ID=your_crisp_chat_id
